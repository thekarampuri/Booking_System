# Firebase Client SDK (Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Firebase Admin SDK (server-side: seed script + cron)
# Download the service account JSON from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Paste the values below:
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Resend (optional, for cron email reminders)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Protect the /api/cron/reminders route
CRON_SECRET=change-this-to-a-long-random-string

# Admin seed (used by scripts/seedAdmin.ts)
ADMIN_SEED_PASSWORD=12345678
